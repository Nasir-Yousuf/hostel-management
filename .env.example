# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/niyd_hms?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/niyd_hms
MONGODB_URI=mongodb://localhost:27017/niyd_hms

# JWT Authentication
JWT_SECRET=niyd_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=niyd_jwt_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (For CORS whitelist in production)
FRONTEND_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
