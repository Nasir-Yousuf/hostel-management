# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# For local development or MongoDB Atlas.
# If connecting to Atlas, replace with your mongodb+srv URI.
MONGODB_URI=mongodb://127.0.0.1:27017/niyd_hms

# JWT Authentication
JWT_SECRET=niyd_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=niyd_jwt_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL
FRONTEND_URL=*

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
